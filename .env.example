# Application
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL. Use a managed development database URL or a native local server.
# Docker Compose overrides DATABASE_URL inside its backend container.
POSTGRES_USER=briefroom_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=briefroom_database
POSTGRES_PORT=5700
BACKEND_PORT=7860
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Security
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# AI and transcription providers (configure the providers you use)
ASSEMBLYAI_API_KEY_1=
ASSEMBLYAI_API_KEY_2=
ASSEMBLYAI_API_KEY_3=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
SUPADATA_API_KEY_1=
SUPADATA_API_KEY_2=
SUPADATA_API_KEY_3=
SUPADATA_API_KEY_4=
SUPADATA_API_KEY_5=

# Email
RESEND_API_KEY=
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Paddle
PADDLE_API_KEY=replace-with-paddle-api-key
PADDLE_WEBHOOK_SECRET=replace-with-paddle-webhook-secret
PADDLE_PRICE_ID=replace-with-paddle-price-id

# Optional initial admin used by scripts/seed_admin.py
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
